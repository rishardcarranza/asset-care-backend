    "/api/v1/sync/pull": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Sync Pull",
        "description": "Deliver all assets, rules, and logs modified or deleted since the provided timestamp.\n\nIntent:\n    Enables incremental delta downloads. Soft-deleted records are included\n    so the mobile SQLite database can apply local deletions.",
        "operationId": "sync_pull_api_v1_sync_pull_get",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "UTC timestamp of the client's last successful synchronization",
              "title": "Since"
            },
            "description": "UTC timestamp of the client's last successful synchronization"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
